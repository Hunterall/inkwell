rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    function isCreatingAsOwner() {
      return isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // ── User Settings & API Keys ──
    // Strictly confidential: Only the user can read or modify their own settings and credentials.
    match /user_settings/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ── Stories ──
    // Stories are strictly private to the authenticated creator.
    match /stories/{storyId} {
      allow read, update, delete: if isDocOwner();
      allow create: if isCreatingAsOwner();
    }

    // ── Chapters / Manuscript ──
    // Private chapter content and book prose.
    match /chapters/{chapterId} {
      allow read, update, delete: if isDocOwner();
      allow create: if isCreatingAsOwner();
    }

    // ── Story Bible Entries ──
    // Private characters, lore, places, and world-building notes.
    match /bible_entries/{entryId} {
      allow read, update, delete: if isDocOwner();
      allow create: if isCreatingAsOwner();
    }

    // ── Storyboard Frames ──
    // Private visual storyboards and scene prompts.
    match /frames/{frameId} {
      allow read, update, delete: if isDocOwner();
      allow create: if isCreatingAsOwner();
    }

    // ── Strict Default Deny ──
    // Any document or collection not explicitly matched above is inaccessible.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
